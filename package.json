{
  "name": "qwenpaw-plugin-token-speed",
  "version": "2.0.0",
  "description": "QwenPaw plugin: real-time LLM token speed, usage and billing (Agent Plan quota / CNY / Aliyun Bailian Token Plan credits).",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check dist/index.js",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.mjs\" \"test/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node test/regression.cjs && node test/lifecycle.cjs",
    "test:regression": "node test/regression.cjs",
    "test:lifecycle": "node test/lifecycle.cjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "author": "ATRML",
  "repository": {
    "type": "git",
    "url": "https://github.com/ATRML/qwenpaw-plugin-token-speed.git"
  }
}